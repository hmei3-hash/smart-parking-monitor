// Filename: secrets.h.example
// Author: Hongyi Mei
// Date: 2026-08-01
// Description: Template for the gitignored secrets.h. Copy this file to
//              secrets.h in the same directory and fill in the values for
//              your network before building.
//
//                  cp src/secrets.h.example src/secrets.h
//
//              Kept out of the firmware source so credentials are not
//              committed. secrets.h is listed in .gitignore.

#pragma once

// WiFi the nodes and the gateway share. On the demo setup this is the
// hotspot published by the Raspberry Pi itself, so the whole system runs
// without depending on campus WiFi.
#define WIFI_SSID  "your-ssid"
#define WIFI_PASS  "your-password"

// Raspberry Pi running Mosquitto. Must be the Pi's address on the same
// subnet as the nodes; when the Pi is the hotspot this is its AP-side
// address, not its uplink address.
#define MQTT_HOST  "192.168.137.1"
